{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "postinstall": "npm --prefix server install",
    "build:client": "vite build",
    "build:server": "npm --prefix server install && npm --prefix server run build",
    "build": "vite build && npx esbuild server/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js && npm --prefix server install && npm --prefix server run build",
    "start": "node server/dist/index.js",
    "db:setup": "npm --prefix server run db:setup"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "0.487.0",
    "pg": "^8.11.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "uuid": "^9.0.0",
    "@radix-ui/react-slot": "1.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@vitejs/plugin-react": "4.7.0",
    "@vercel/node": "^3.2.0",
    "tailwindcss": "4.1.12",
    "vite": "6.3.5"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5"
    }
  }
}