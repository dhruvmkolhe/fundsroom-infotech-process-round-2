# Server Environment Variables
# Copy this file to .env and fill in your values

# Server port
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/mini_erp

# JWT signing secret — change this in production!
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# JWT token expiry
JWT_EXPIRES_IN=24h

# Node environment
NODE_ENV=development

# Comma-separated list of allowed frontend origins (CORS)
# Local dev:   http://localhost:5173
# Production:  https://fundsroom-infotech-process-round-2.vercel.app
CORS_ORIGIN=http://localhost:5173
